[Unit]
Description=Discord Gemini and Groq chat bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discord-ai
Group=discord-ai
WorkingDirectory=/opt/discord-ai-bot
EnvironmentFile=/etc/discord-ai-bot/env
Environment=TZ=Europe/Istanbul
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/discord-ai-bot/.venv/bin/python llmcord.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/var/lib/discord-ai-memory
UMask=0077

[Install]
WantedBy=multi-user.target
